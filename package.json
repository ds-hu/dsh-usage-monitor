{
  "name": "dsh-token-quota",
  "version": "2.2.0",
  "description": "DeepSeek Harness 用量监控：官方侧栏完整／紧凑卡片、供应商分栏详情及概览、供应商、设置配置面板，按当前会话显示周期限额、逐币种余额与报告用量费用；保留凭据类别隔离、自动识别普通 API Key 与本地今日用量统计。",
  "icon": "./icon.svg",
  "author": "shxtmaker <https://github.com/shxtmaker>",
  "license": "MIT",
  "homepage": "https://github.com/shxtmaker/dsh-token-quota",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shxtmaker/dsh-token-quota.git"
  },
  "bugs": {
    "url": "https://github.com/shxtmaker/dsh-token-quota/issues"
  },
  "files": [
    "lib",
    "test",
    "scripts",
    "playwright.config.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "CHANGELOG.md",
    "docs/windows-desktop-adaptation.md",
    "CONTEXT.md",
    "ui-prototype.html"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.7-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "scripts": {
    "test": "node --test test/*.mjs",
    "test:browser": "playwright test",
    "test:desktop": "node scripts/verify-desktop.mjs",
    "test:lifecycle": "node scripts/verify-lifecycle.cjs",
    "test:pack": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1"
  }
}
